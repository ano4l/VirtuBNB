# Public web configuration for a static Vercel deployment.
# This URL must point to the authenticated VirtuHost API or Supabase Edge Function.
# Never add OpenAI, WhatsApp, Supabase service-role, or browser-executor credentials here.
VITE_API_URL=https://api.example.com

# Optional only when hosting below a sub-path.
# VITE_BASE_PATH=/

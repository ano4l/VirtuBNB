{
  "name": "virtuhost",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "demo:chat": "pnpm --filter @virtuhost/api demo:chat",
    "dev:api": "pnpm --filter @virtuhost/api dev",
    "dev:web": "pnpm --filter @virtuhost/web dev",
    "dev": "pnpm --parallel --filter @virtuhost/api --filter @virtuhost/web dev",
    "test": "pnpm --filter @virtuhost/api test",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "build": "pnpm --recursive --if-present build"
  }
}

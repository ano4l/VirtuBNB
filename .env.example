# API
PORT=4100
NODE_ENV=development

# Browser-safe frontend settings. The Vite dev proxy forwards these paths to
# the local API; no server credential belongs in a VITE_* variable.
VITE_API_URL=
VITE_API_PROXY_TARGET=http://127.0.0.1:4100
VITE_BASE_PATH=/
VITE_DEV_HOST=127.0.0.1
VITE_DEV_PORT=5173

# Use a long random value and enter the same value in Meta webhook settings.
WHATSAPP_VERIFY_TOKEN=replace-me

# Required only when WHATSAPP_TRANSPORT=cloud.
WHATSAPP_TRANSPORT=demo
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=
META_APP_SECRET=

# Single-host development connection; comma-separated international digits, no +.
HOST_WHATSAPP_NUMBERS=
# Minimum 24 characters. Keep server-side; do not bundle in the mobile app.
HOST_API_TOKEN=
